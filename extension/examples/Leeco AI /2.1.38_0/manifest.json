{
   "action": {
      "default_icon": {
         "128": "Leeco.png"
      },
      "default_title": "Open Leeco AI"
   },
   "background": {
      "service_worker": "background.js",
      "type": "module"
   },
   "content_scripts": [ {
      "css": [ "content.css" ],
      "js": [ "content.js" ],
      "matches": [ "\u003Call_urls>" ],
      "run_at": "document_idle"
   } ],
   "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self'"
   },
   "description": "Leeco AI is your all-in-one Chrome extension for automating job search & mastering tech interviews—with an AI mentor at every step.",
   "host_permissions": [ "\u003Call_urls>" ],
   "icons": {
      "128": "Leeco.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Leeco AI – Auto-Apply Jobs on LinkedIn & Upskill for Job Interviews",
   "permissions": [ "sidePanel", "activeTab", "storage", "tabs" ],
   "side_panel": {
      "default_path": "sidepanel.html"
   },
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "2.1.38"
}
