{
   "action": {
      "default_icon": {
         "128": "icons/icon128.png",
         "16": "icons/icon16.png",
         "32": "icons/icon32.png",
         "48": "icons/icon48.png"
      },
      "default_popup": "popup.html"
   },
   "author": "CareerGPT",
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "js": [ "siteDetector.js", "jobSiteStrategy.js", "formAnalyzer.js", "database-api.js", "agent.js", "content.js" ],
      "matches": [ "*://*.linkedin.com/jobs/*", "*://*.linkedin.com/jobs", "*://*.linkedin.com/my-items/saved-jobs/*" ],
      "run_at": "document_end"
   } ],
   "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://careergpt.io/api/*"
   },
   "description": "Job application automation powered by CareerGPT - Apply to LinkedIn jobs efficiently",
   "homepage_url": "https://careergpt.io",
   "host_permissions": [ "*://*.linkedin.com/jobs/*", "*://*.linkedin.com/jobs", "*://*.linkedin.com/my-items/saved-jobs/*", "https://careergpt.io/api/*" ],
   "icons": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "LinkedIn Agent Auto Apply",
   "permissions": [ "activeTab", "storage" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "2.1.1"
}
