   "permissions": [ "storage", "tabs", "declarativeNetRequest" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "9.06",
   "web_accessible_resources": [ {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "dist/*" ]
   }, {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "models/*" ]
   } ]
