      "matches": [ "*://*.indeed.com/*", "*://smartapply.indeed.com/*", "*://portal.teemo.ai/*" ]
   }, {
      "js": [ "constants/api.constants.js", "constants/env.constants.js", "constants/constants.js", "domain.js", "content_utils.js", "ui/sidebar.js", "create_elements.js", "smartapply/questionAnswer.js", "glassdoor_scripts/g_content.js", "smartapply/applyForm.js" ],
      "matches": [ "*://*.glassdoor.com/*", "*://*.glassdoor.co.in/*", "*://*.glassdoor.co.uk/*", "*://*.glassdoor.ca/*", "*://*.glassdoor.com.au/*", "*://smartapply.indeed.com/*", "*://portal.teemo.ai/*" ]
   }, {
      "js": [ "constants/api.constants.js", "constants/env.constants.js", "constants/constants.js", "connector.js", "domain.js", "content_utils.js", "debounce.js", "ui/sidebar.js", "create_elements.js", "monster/m_content.js" ],
      "matches": [ "*://*.monster.com/*", "https://www.monster.com/profile/apply*" ],
      "run_at": "document_idle"
   }, {
      "js": [ "constants/api.constants.js", "constants/env.constants.js", "constants/constants.js", "connector.js", "domain.js", "content_utils.js", "ui/sidebar.js", "create_elements.js", "ziprecruiter_scripts/z_content.js" ],
      "matches": [ "*://*.ziprecruiter.com/*", "*://portal.teemo.ai/*" ],
      "run_at": "document_idle"
   }, {
      "js": [ "constants/api.constants.js", "constants/env.constants.js", "constants/constants.js", "connector.js", "domain.js", "content_utils.js", "ui/sidebar.js", "create_elements.js", "autofill_scripts/uiManager.js", "autofill_scripts/auto-fill-content.js" ],
      "matches": [ "*://*.job-boards.greenhouse.io/*", "*://boards.greenhouse.io/*", "*://jobs.lever.co/*", "*://jobs.ashbyhq.com/*", "*://*.breezy.hr/*", "*://*.recruitee.com/*", "*://apply.workable.com/*", "*://jobs.jobvite.com/*", "*://jobs.workable.com/*" ]
   } ],
   "declarative_net_request": {
      "rule_resources": [ {
         "enabled": true,
         "id": "ruleset_1",
         "path": "rules.json"
      } ]
   },
   "description": "Teemo AI helps job seekers fill out repetitive applications faster using smart automation. Works on popular job platforms",
   "externally_connectable": {
      "matches": [ "https://portal.teemo.ai/*" ]
   },
   "host_permissions": [ "https://smartapply.indeed.com/*", "https://www.monster.com/*", "*://*.google.com/recaptcha/*", "*://*.recaptcha.net/recaptcha/*" ],
   "key": "",
   "manifest_version": 3,
