{
   "action": {
      "default_popup": "popup.html"
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "all_frames": true,
      "js": [ "recaptcha.js" ],
      "match_about_blank": false,
      "matches": [ "*://*.google.com/recaptcha/api2/*", "*://*.google.com/recaptcha/enterprise/*", "*://*.recaptcha.net/recaptcha/api2/*", "*://*.recaptcha.net/recaptcha/enterprise/*" ],
      "run_at": "document_idle"
   }, {
      "all_frames": true,
      "js": [ "recaptcha-visibility.js" ],
      "match_about_blank": false,
      "matches": [ "\u003Call_urls>" ],
      "run_at": "document_end"
   }, {
      "js": [ "constants/api.constants.js", "constants/env.constants.js", "constants/constants.js", "connector.js", "domain.js", "content_utils.js", "debounce.js", "ui/sidebar.js", "create_elements.js", "linkedin_scripts/content.js" ],
      "matches": [ "*://*.linkedin.com/*", "*://portal.teemo.ai/*" ]
   }, {
