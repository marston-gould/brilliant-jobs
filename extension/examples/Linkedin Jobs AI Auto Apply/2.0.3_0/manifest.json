{
   "action": {
      "default_icon": {
         "128": "laaa_logo_128x128.png",
         "16": "laaa_logo_16x16.png",
         "48": "laaa_logo_48x48.png"
      },
      "default_title": "Auto Apply Settings"
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "js": [ "content.js" ],
      "matches": [ "https://*.linkedin.com/*" ]
   } ],
   "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'; frame-src https://www.youtube.com https://www.youtube-nocookie.com"
   },
   "description": "Automate & autofill job applications with AI",
   "host_permissions": [ "https://qerds.com/*", "https://*.linkedin.com/*" ],
   "icons": {
      "128": "laaa_logo_128x128.png",
      "16": "laaa_logo_16x16.png",
      "48": "laaa_logo_48x48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "LinkedIn Jobs AI Auto Apply",
   "options_ui": {
      "page": "settings.html"
   },
   "permissions": [ "storage", "activeTab", "tabs", "notifications" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "2.0.3",
   "web_accessible_resources": [ {
      "matches": [ "https://*.linkedin.com/*" ],
      "resources": [ "assets/compressed_resume.yaml" ]
   } ]
}
