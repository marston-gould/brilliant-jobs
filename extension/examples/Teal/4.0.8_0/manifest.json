{
   "action": {
      "default_title": "Toggle Teal Sidebar"
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "css": [ "content-scripts/content.css" ],
      "js": [ "content-scripts/content.js" ],
      "matches": [ "http://*/*", "https://*/*" ]
   } ],
   "description": "The better way to job search. Save Jobs, Contacts, Companies & Resumes in one place.",
   "homepage_url": "https://www.tealhq.com",
   "icons": {
      "128": "icon/128.png",
      "16": "icon/16.png",
      "24": "icon/24.png",
      "32": "icon/32.png",
      "48": "icon/48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Teal - Job Search Companion",
   "permissions": [ "storage", "tabs", "activeTab", "sidePanel" ],
   "side_panel": {
      "default_path": "sidepanel.html"
   },
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "4.0.8"
}
