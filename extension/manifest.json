{
  "manifest_version": 3,
  "name": "Brilliant Jobs",
  "version": "2.26.0",
  "description": "Discover jobs through your professional network",
  "homepage_url": "https://brilliantjobs.app/privacy",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "alarms",
    "sidePanel",
    "notifications"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://qojhagupdnbtomfoxnsf.supabase.co/*",
    "https://brilliantjobs.app/*",
    "https://www.brilliantjobs.app/*",
    "https://boards.greenhouse.io/*",
    "https://boards.eu.greenhouse.io/*",
    "https://job-boards.greenhouse.io/*",
    "https://job-boards.eu.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://jobs.ashbyhq.com/*",
    "https://apply.workable.com/*",
    "https://*.recruitee.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://smartapply.indeed.com/*",
    "https://apply.indeed.com/*",
    "https://m5.apply.indeed.com/*",
    "https://*.indeed.com/*",
    "https://*.icims.com/*",
    "https://*.taleo.net/*",
    "https://jobs.smartrecruiters.com/*",
    "https://careers.smartrecruiters.com/*",
    "https://*.avature.net/*",
    "https://*.bamboohr.com/*",
    "https://*.applytojob.com/*",
    "https://www.glassdoor.com/*",
    "https://www.glassdoor.co.uk/*",
    "https://*.joinhandshake.com/*",
    "https://www.indeed.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "interceptor-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://boards.eu.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://job-boards.eu.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://apply.workable.com/*",
        "https://*.recruitee.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://smartapply.indeed.com/*",
        "https://apply.indeed.com/*",
        "https://m5.apply.indeed.com/*",
        "https://*.icims.com/*",
        "https://*.taleo.net/*",
        "https://jobs.smartrecruiters.com/*",
        "https://careers.smartrecruiters.com/*",
        "https://*.avature.net/*",
        "https://*.bamboohr.com/*",
        "https://*.applytojob.com/*",
        "https://www.glassdoor.com/*",
        "https://www.glassdoor.co.uk/*",
        "https://*.joinhandshake.com/*",
        "https://www.indeed.com/*"
      ],
      "js": [
        "contentScript.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://brilliantjobs.app/*",
        "https://www.brilliantjobs.app/*"
      ],
      "js": [
        "token-sync.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "popup.html"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "handlers/*.js",
        "utils/fillMetrics.js",
        "inject-overlay.js",
        "toolbar-overlay.js",
        "inject.css",
        "job-site-overlay.js"
      ],
      "matches": [
        "https://www.linkedin.com/*",
        "https://boards.greenhouse.io/*",
        "https://boards.eu.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://job-boards.eu.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://apply.workable.com/*",
        "https://*.recruitee.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://smartapply.indeed.com/*",
        "https://apply.indeed.com/*",
        "https://m5.apply.indeed.com/*",
        "https://*.indeed.com/*",
        "https://*.icims.com/*",
        "https://*.taleo.net/*",
        "https://jobs.smartrecruiters.com/*",
        "https://careers.smartrecruiters.com/*",
        "https://*.avature.net/*",
        "https://*.bamboohr.com/*",
        "https://*.applytojob.com/*",
        "https://www.glassdoor.com/*",
        "https://www.glassdoor.co.uk/*",
        "https://*.joinhandshake.com/*",
        "https://www.indeed.com/*"
      ]
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://brilliantjobs.app/*",
      "https://www.brilliantjobs.app/*",
      "https://staging.brilliantjobs.app/*"
    ]
  }
}
