{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "WebWorker"],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "allowJs": false,
    "declaration": true,
    "declarationDir": "./types/generated",
    "outDir": "./dist/ts-out",
    "rootDir": ".",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "typeRoots": ["./types", "./node_modules/@types"]
  },
  "include": [
    "types/**/*.d.ts",
    "*.ts",
    "utils/**/*.ts",
    "handlers/**/*.ts",
    "fields/**/*.ts",
    "selectors/**/*.ts"
  ],
  "exclude": [
    "dist",
    "examples",
    "build-extension.js",
    "node_modules"
  ]
}
