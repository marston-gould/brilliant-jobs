{
  "compilerOptions": {
    // === Strict Mode (non-negotiable) ===
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,

    // === Additional Safety ===
    // BI-07: noUnusedLocals/Parameters disabled at tsc level.
    // Unused variables are caught by ESLint (no-unused-vars) which provides
    // better control over allowances. These are code hygiene, not type safety.
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,

    // === Module System ===
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false,

    // === JSX (SA-013: React SPA) ===
    "jsx": "react-jsx",

    // === Output ===
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    // === Path Aliases (SA-013: SPA imports) ===
    "baseUrl": ".",
    "paths": {
      "@app/*": ["src/app/*"],
      "@components": ["src/app/components/index.ts"],
      "@components/*": ["src/app/components/*"],
      "@providers": ["src/app/providers/index.ts"],
      "@providers/*": ["src/app/providers/*"],
      "@shell": ["src/app/shell/index.ts"],
      "@shell/*": ["src/app/shell/*"],
      "@lib/*": ["src/app/lib/*"]
    },

    // === Type Roots ===
    "typeRoots": ["./node_modules/@types", "./js/types"],
    "lib": ["ES2020", "DOM", "DOM.Iterable"]
  },
  "include": [
    "js/**/*.ts",
    "js/types/**/*.d.ts",
    "src/app/**/*.ts",
    "src/app/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "extension",
    "supabase",
    "tests",
    "scripts"
  ]
}
