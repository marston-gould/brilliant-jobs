{
  "name": "brilliant-jobs",
  "private": true,
  "description": "Build tools are local-only. Vercel serves static files.",
  "scripts": {
    "bundle:js": "node build.js",
    "bundle:css": "npx tailwindcss -i src/input.css -o styles.css --minify",
    "bundle": "npm run bundle:js && npm run bundle:css",
    "css:watch": "npx tailwindcss -i src/input.css -o styles.css --watch",
    "dev": "npx vite"
  },
  "devDependencies": {
    "axe-core": "^4.11.1",
    "esbuild": "^0.25.12",
    "tailwindcss": "^3.4.19",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "acorn": "^8.16.0"
  }
}
