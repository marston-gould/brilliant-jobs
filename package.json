{
  "name": "brilliant-jobs",
  "private": true,
  "description": "Build tools are local-only. Vercel serves static files.",
  "scripts": {
    "bundle:js": "node build.js",
    "bundle:css": "npx tailwindcss -i src/input.css -o styles.css --minify",
    "bundle": "npm run bundle:js && npm run bundle:css",
    "css:watch": "npx tailwindcss -i src/input.css -o styles.css --watch",
    "dev": "npx vite",
    "dev:spa": "npx vite --open /src/app/index.html",
    "build:spa": "npx vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "selector:check": "node scripts/selector-health-check.mjs",
    "selector:check:registry": "node scripts/selector-health-check.mjs --report-only",
    "selector:alert": "node scripts/selector-alert.mjs",
    "lint": "eslint .",
    "gate:posthog": "node scripts/gate-posthog-verify.mjs",
    "gate:auth": "node scripts/gate-ef-auth-scan.mjs",
    "gate:secrets": "node scripts/gate-secret-scan.mjs",
    "gate:bundle": "node scripts/gate-bundle-size.mjs",
    "gate:all": "npm run gate:posthog && npm run gate:auth && npm run gate:secrets && npm run gate:bundle"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^25.3.5",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.1.4",
    "axe-core": "^4.11.1",
    "esbuild": "^0.27.3",
    "eslint": "^10.0.3",
    "eslint-plugin-no-only-tests": "^3.3.0",
    "jsdom": "^28.1.0",
    "playwright": "^1.50.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "yaml": "^2.8.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "acorn": "^8.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.3"
  }
}
